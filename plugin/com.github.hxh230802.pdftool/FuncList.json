{
  "appName": "PDF 工具",
  "specVersion": "1.0",
  "manifestVersion": "1.0.0",
  "openSocket": {
    "merge": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "合并多个 PDF 文件为一个",
      "args": {
        "action": { "type": "static", "value": "merge", "description": "命令类型" },
        "pdf_list": { "type": "input", "defaultVal": "[\"a.pdf\", \"b.pdf\"]", "description": "PDF 文件路径列表（JSON 数组）" },
        "output_path": { "type": "input", "defaultVal": "merged.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["合并文件数", "merged"]
      ]
    },
    "split": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "拆分 PDF 为多个文件，支持按页数或按书签拆分",
      "args": {
        "action": { "type": "static", "value": "split", "description": "命令类型" },
        "pdf_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_dir": { "type": "input", "defaultVal": "./split_out", "description": "输出目录" },
        "mode": {
          "type": "optional",
          "options": [["按页数拆分", "pages"], ["按书签拆分", "bookmarks"]],
          "description": "拆分模式"
        },
        "pages_per_split": { "type": "input", "defaultVal": "1", "description": "每份文件页数（mode=pages 时生效）" }
      },
      "returns": [
        ["输出目录", "output_dir"],
        ["输出文件列表", "output_files"],
        ["总页数", "total_pages"]
      ]
    },
    "extract": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "提取 PDF 中的指定页面为新文件",
      "args": {
        "action": { "type": "static", "value": "extract", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "[1, 2]", "description": "要提取的页码列表（1-based，JSON 数组）" },
        "output_path": { "type": "input", "defaultVal": "extracted.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["提取页数", "extracted"]
      ]
    },
    "rotate": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "旋转指定页面，角度必须是 90 的倍数",
      "args": {
        "action": { "type": "static", "value": "rotate", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "[1]", "description": "要旋转的页码列表（1-based，JSON 数组）" },
        "degrees": {
          "type": "optional",
          "options": [["顺时针 90°", "90"], ["180°", "180"], ["逆时针 90°", "270"]],
          "description": "旋转角度"
        },
        "output_path": { "type": "input", "defaultVal": "rotated.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["旋转页数", "rotated"],
        ["旋转角度", "degrees"]
      ]
    },
    "reorder": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "重新排序 PDF 页面，必须提供包含全部页面的完整顺序",
      "args": {
        "action": { "type": "static", "value": "reorder", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "[3, 1, 2]", "description": "新页面顺序（1-based，JSON 数组，必须覆盖全部页面）" },
        "output_path": { "type": "input", "defaultVal": "reordered.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["重排页数", "reordered"]
      ]
    },
    "insert": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "在指定位置插入另一个 PDF 的全部页面",
      "args": {
        "action": { "type": "static", "value": "insert", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "目标 PDF 路径" },
        "insert_from_path": { "type": "input", "defaultVal": "", "description": "要插入的 PDF 路径" },
        "at_page": { "type": "input", "defaultVal": "1", "description": "插入位置（1-based，插入到此页之前，可设为最后一页之后）" },
        "output_path": { "type": "input", "defaultVal": "inserted.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["插入页数", "inserted"],
        ["插入位置", "at_page"],
        ["总页数", "total_pages"]
      ]
    },
    "remove": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "删除 PDF 中指定页面",
      "args": {
        "action": { "type": "static", "value": "remove", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "[1]", "description": "要删除的页码列表（1-based，JSON 数组）" },
        "output_path": { "type": "input", "defaultVal": "removed.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["删除页数", "removed"],
        ["剩余总页数", "total_pages"]
      ]
    },
    "optimize": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "pages",
      "description": "压缩/优化 PDF 以减小文件体积",
      "args": {
        "action": { "type": "static", "value": "optimize", "description": "命令类型" },
        "pdf_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "optimized.pdf", "description": "输出 PDF 路径" },
        "quality": {
          "type": "optional",
          "options": [["最大压缩", "low"], ["均衡（推荐）", "medium"], ["最小压缩", "high"]],
          "description": "压缩质量"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["原文件大小", "original_size"],
        ["优化后大小", "optimized_size"],
        ["压缩率", "compression_ratio"],
        ["体积缩减百分比", "size_reduction_percent"]
      ]
    },

    "images-to-pdf": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "convert",
      "description": "将多张图片合并转换为一个 PDF 文件",
      "args": {
        "action": { "type": "static", "value": "images-to-pdf", "description": "命令类型" },
        "image_paths": { "type": "input", "defaultVal": "[\"scan1.jpg\", \"scan2.png\"]", "description": "图片路径列表（JSON 数组）" },
        "output_path": { "type": "input", "defaultVal": "output.pdf", "description": "输出 PDF 路径" },
        "page_size": {
          "type": "optional",
          "options": [["自适应图片", "auto"], ["A4 纵向", "A4"], ["A4 横向", "A4-landscape"], ["Letter", "Letter"]],
          "description": "页面尺寸"
        },
        "fit": {
          "type": "optional",
          "options": [["等比缩放适配", "fit"], ["拉伸填满", "fill"], ["居中不缩放", "center"]],
          "description": "图片适配方式"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["图片数量", "image_count"],
        ["总页数", "page_count"]
      ]
    },
    "export": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "convert",
      "description": "将 PDF 导出为 Markdown 或 JSON 格式",
      "args": {
        "action": { "type": "static", "value": "export", "description": "命令类型" },
        "pdf_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "output.md", "description": "输出文件路径" },
        "format": {
          "type": "optional",
          "options": [["Markdown", "markdown"], ["JSON", "json"]],
          "description": "导出格式"
        },
        "pages": { "type": "input", "defaultVal": "", "description": "要导出的页码（JSON 数组，留空表示全部）" },
        "engine": {
          "type": "optional",
          "options": [["自动", "auto"], ["原生文本", "native"], ["OCR 识别", "ocr"]],
          "description": "文本提取引擎"
        },
        "language": { "type": "input", "defaultVal": "eng", "description": "OCR 语言代码" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["提取引擎", "engine"],
        ["导出页数", "pages"]
      ]
    },

    "get-fields": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "读取 PDF 表单中的所有字段名称和类型",
      "args": {
        "action": { "type": "static", "value": "get-fields", "description": "命令类型" },
        "pdf_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" }
      },
      "returns": [
        ["表单字段（JSON 对象）", "fields"],
        ["字段数量", "count"]
      ]
    },
    "fill": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "填写标准 PDF 表单（AcroForm），支持一键固化",
      "args": {
        "action": { "type": "static", "value": "fill", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "filled.pdf", "description": "输出 PDF 路径" },
        "data": { "type": "input", "defaultVal": "{\"Name\": \"张三\"}", "description": "表单数据（JSON 对象）" },
        "flatten": {
          "type": "optional",
          "options": [["不固化", "false"], ["固化（锁定）", "true"]],
          "description": "是否扁平化"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["是否已固化", "flattened"],
        ["填充引擎", "filled_with"],
        ["匹配字段数", "matched"],
        ["总字段数", "total"]
      ]
    },
    "fill-any": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "智能填写 PDF 表单，自动检测标签匹配字段（适用于非标准表单）",
      "args": {
        "action": { "type": "static", "value": "fill-any", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "filled.pdf", "description": "输出 PDF 路径" },
        "data": { "type": "input", "defaultVal": "{\"姓名\": \"张三\", \"邮箱\": \"test@example.com\"}", "description": "表单数据（JSON 对象，自动匹配标签）" },
        "flatten": {
          "type": "optional",
          "options": [["不固化", "false"], ["固化（锁定）", "true"]],
          "description": "是否扁平化"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["匹配方式", "fill_method"],
        ["已填写字段", "filled_fields"],
        ["未匹配字段", "unmatched_fields"]
      ]
    },
    "create-form": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "创建一个新的带 AcroForm 表单字段的 PDF",
      "args": {
        "action": { "type": "static", "value": "create-form", "description": "命令类型" },
        "output_path": { "type": "input", "defaultVal": "form.pdf", "description": "输出 PDF 路径" },
        "fields": { "type": "input", "defaultVal": "[{\"name\": \"Name\", \"type\": \"text\", \"rect\": [100, 700, 400, 720]}]", "description": "表单字段定义（JSON 数组，每项含 name/type/rect/page/value/multiline）" },
        "page_size": {
          "type": "optional",
          "options": [["A4", "A4"], ["Letter", "Letter"]],
          "description": "页面尺寸"
        },
        "pages": { "type": "input", "defaultVal": "1", "description": "总页数" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["创建字段数", "field_count"],
        ["总页数", "page_count"]
      ]
    },
    "get-form-templates": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "列出所有内置表单模板（发票、合同等常见场景）",
      "args": {
        "action": { "type": "static", "value": "get-form-templates", "description": "命令类型" }
      },
      "returns": [
        ["模板列表（JSON 对象，模板名→描述）", "templates"],
        ["模板数量", "count"]
      ]
    },
    "create-from-template": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "使用内置模板创建 PDF 表单",
      "args": {
        "action": { "type": "static", "value": "create-from-template", "description": "命令类型" },
        "output_path": { "type": "input", "defaultVal": "form.pdf", "description": "输出 PDF 路径" },
        "template_name": { "type": "input", "defaultVal": "", "description": "模板名称（从 get-form-templates 获取）" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["使用的模板名", "template_name"],
        ["模板描述", "template_description"]
      ]
    },
    "flatten": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "扁平化 PDF 表单，移除可编辑字段和注释，变为静态文档",
      "args": {
        "action": { "type": "static", "value": "flatten", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "flattened.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["固化引擎", "flattened_with"]
      ]
    },
    "clear-fields": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "清空 PDF 表单中已填写的值（保留字段结构，可重新填写）",
      "args": {
        "action": { "type": "static", "value": "clear-fields", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "cleared.pdf", "description": "输出 PDF 路径" },
        "fields": { "type": "input", "defaultVal": "", "description": "要清空的字段列表（JSON 数组，留空清空全部）" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["清空的字段数", "cleared"],
        ["清空的字段列表", "fields"]
      ]
    },
    "detect-fields": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "form",
      "description": "智能检测 PDF 中可能存在的表单字段（适用于没有 AcroForm 的扫描表单）",
      "args": {
        "action": { "type": "static", "value": "detect-fields", "description": "命令类型" },
        "pdf_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "", "description": "要检测的页码（JSON 数组，留空表示全部）" }
      },
      "returns": [
        ["是否有 AcroForm", "has_acroform"],
        ["已检测标签数", "total_labels"],
        ["已检测复选框数", "total_checkboxes"],
        ["每页检测结果（JSON 数组）", "page_analyses"]
      ]
    },

    "add-annotation": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
      "description": "在 PDF 页面添加 FreeText 文本注释",
      "args": {
        "action": { "type": "static", "value": "add-annotation", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "page": { "type": "input", "defaultVal": "1", "description": "页码（1-based）" },
        "text": { "type": "input", "defaultVal": "注释内容", "description": "注释文本" },
        "output_path": { "type": "input", "defaultVal": "annotated.pdf", "description": "输出 PDF 路径" },
        "rect": { "type": "input", "defaultVal": "[100, 500, 400, 520]", "description": "注释区域（JSON 数组 [x1, y1, x2, y2]，留空自动定位）" },
        "annotation_id": { "type": "input", "defaultVal": "", "description": "注释 ID（留空自动生成，用于后续修改/删除）" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["注释 ID", "annotation_id"],
        ["页码", "page"]
      ]
    },
    "update-annotation": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
      "description": "更新已有 FreeText 注释的内容或位置",
      "args": {
        "action": { "type": "static", "value": "update-annotation", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "annotation_id": { "type": "input", "defaultVal": "", "description": "注释 ID（必填）" },
        "text": { "type": "input", "defaultVal": "修改后的文本", "description": "新文本内容" },
        "output_path": { "type": "input", "defaultVal": "updated.pdf", "description": "输出 PDF 路径" },
        "rect": { "type": "input", "defaultVal": "", "description": "新注释区域（JSON 数组 [x1, y1, x2, y2]，留空不改变）" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["注释 ID", "annotation_id"]
      ]
    },
    "remove-annotation": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
      "description": "删除指定 FreeText 注释",
      "args": {
        "action": { "type": "static", "value": "remove-annotation", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "annotation_id": { "type": "input", "defaultVal": "", "description": "注释 ID（必填）" },
        "output_path": { "type": "input", "defaultVal": "removed.pdf", "description": "输出 PDF 路径" }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["删除的注释 ID", "annotation_id"]
      ]
    },
    "remove-annotations": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
      "description": "批量删除指定页面的注释，可按类型过滤",
      "args": {
        "action": { "type": "static", "value": "remove-annotations", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "cleaned.pdf", "description": "输出 PDF 路径" },
        "pages": { "type": "input", "defaultVal": "", "description": "页码列表（JSON 数组，留空表示全部）" },
        "subtype": {
          "type": "optional",
          "options": [["全部类型", ""], ["FreeText", "FreeText"], ["高亮", "Highlight"], ["便签", "Text"], ["印章", "Stamp"]],
          "description": "要删除的注释类型"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["删除的注释数", "removed"]
      ]
    },
    "redact": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
      "description": "使用正则表达式搜索并永久删除文本（真·红删，不可恢复）",
      "args": {
        "action": { "type": "static", "value": "redact", "description": "命令类型" },
        "input_path": { "type": "input", "defaultVal": "", "description": "输入 PDF 路径" },
        "output_path": { "type": "input", "defaultVal": "redacted.pdf", "description": "输出 PDF 路径" },
        "pattern": { "type": "input", "defaultVal": "", "description": "正则表达式模式" },
        "pages": { "type": "input", "defaultVal": "", "description": "要处理的页码（JSON 数组，留空表示全部）" },
        "case_insensitive": {
          "type": "optional",
          "options": [["区分大小写", "false"], ["忽略大小写", "true"]],
          "description": "是否忽略大小写"
        },
        "whole_words": {
          "type": "optional",
          "options": [["匹配子串", "false"], ["仅匹配完整单词", "true"]],
          "description": "是否仅匹配完整单词"
        }
      },
      "returns": [
        ["输出文件路径", "output_path"],
        ["已删除处数", "redacted"],
        ["处理页数", "pages"]
      ]
    },
    "page-numbers": {
      "appID": "com.github.hxh230802.pdftool",
      "openSocketID": "text",
